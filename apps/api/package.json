{
  "name": "@valyria/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --target node20 --clean",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "xrpl:bootstrap:testnet": "tsx src/scripts/xrpl-bootstrap-testnet.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.4.0",
    "@fastify/websocket": "^11.0.1",
    "@valyria/cache": "workspace:*",
    "@valyria/database": "workspace:*",
    "@valyria/domain": "workspace:*",
    "@valyria/xrpl": "workspace:*",
    "fastify": "^5.1.0",
    "ripple-keypairs": "^2.0.0",
    "xrpl": "^4.6.0",
    "zod": "^3.24.1"
  }
}
